{
  "name": "@crew/mac",
  "productName": "Crew",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "web": "vite",
    "typecheck": "tsc -p .",
    "bundle:main": "esbuild electron/main.cjs --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=build/main.cjs --log-level=warning && cp electron/preload.cjs build/preload.cjs",
    "dist": "vite build && pnpm bundle:main && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@crew/protocol": "workspace:*",
    "@crew/ui": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "dompurify": "^3.3.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "marked": "^17.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.0"
  },
  "description": "Crew for macOS: the app you work with your digital team in.",
  "author": "pveen2"
}
