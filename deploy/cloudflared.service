[Unit]
Description=Cloudflare Tunnel for Crew and SSH
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 --protocol http2 run --token-file /etc/cloudflared/token
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
