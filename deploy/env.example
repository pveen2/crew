# /home/crew/crew-app/.env.local on a team server (mode 600, owner crew).
CREW_HOME=/home/crew/.crew
CREW_TEAM_DIR=/home/crew/team/crew
CREW_PORT=4317
# Only used without Cloudflare Access (with Access the Google login is enough).
CREW_TOKEN=
# Cloudflare Access: the team domain and the Access application's AUD tag.
CREW_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CREW_ACCESS_AUD=
# Who may sign tools (engines, Shopify) in from the app, for the whole team.
CREW_ADMINS=you@example.com
# The app's public address, for share links (https only).
CREW_PUBLIC_URL=https://crew.example.com
# Linux ARM has no Chrome for Testing; Chromium installed root-owned (see briefing).
AGENT_BROWSER_EXECUTABLE_PATH=/opt/crew-chromium/chrome
# SHOPIFY_STORE=<store>.myshopify.com
